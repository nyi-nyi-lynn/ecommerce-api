# ==============================================================================
# 1. APPLICATION & SERVER CONFIGURATION
# ==============================================================================

# Runtime environment ('development', 'production', or 'test')
NODE_ENV=development

# HTTP port the NestJS server listens on (default: 3000)
PORT=3000

# Allowed CORS origin(s) for browser requests with credentials (cookies).
# Use 'true' to reflect the request origin in development, or a comma-separated list of URLs in production (e.g., https://example.com,https://admin.example.com)
CORS_ORIGIN=true

# Express 'trust proxy' setting for resolving the real client IP behind reverse proxies.
# Set to 'false' for direct connections, or a trusted proxy hop count (e.g., '1') behind Nginx/Cloudflare/load balancers
TRUST_PROXY=false

# Explicitly enable Swagger API docs (/api/docs) in production ('true' or 'false').
# Note: Swagger is automatically enabled when NODE_ENV is not 'production'
SWAGGER_ENABLED=false

# ==============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ==============================================================================

# PostgreSQL connection string used by Prisma Client and migrations
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce_db?schema=public

# ==============================================================================
# 3. AUTHENTICATION & JWT CONFIGURATION
# ==============================================================================

# Secret key used to sign and verify JWT access tokens (use a long random string)
JWT_SECRET=replace-with-a-strong-random-jwt-secret

# Access token expiration duration (format: <number>s|m|h|d, up to 24 hours; default: '1d')
JWT_ACCESS_TOKEN_TTL=15m

# Refresh token expiration duration in seconds (positive integer up to 1 year; 604800 = 7 days)
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# ==============================================================================
# 4. CLOUDINARY FILE UPLOAD CONFIGURATION
# ==============================================================================

# Cloudinary account cloud name for product, brand, category, and payment proof images
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key
CLOUDINARY_API_KEY=

# Cloudinary API secret
CLOUDINARY_API_SECRET=

# ==============================================================================
# 5. REDIS CONNECTION CONFIGURATION
# ==============================================================================

# Redis server hostname or IP address (default: 127.0.0.1)
REDIS_HOST=127.0.0.1

# Redis server TCP port (1-65535; default: 6379)
REDIS_PORT=6379

# Redis authentication password (leave empty if Redis has no password configured)
REDIS_PASSWORD=

# Redis logical database index (0-15; default: 0)
REDIS_DB=0

# ==============================================================================
# 6. DEVICE-BASED RATE LIMITING CONFIGURATION
# ==============================================================================

# When 'true', requests are allowed through if Redis is temporarily unavailable (fail-open).
# When 'false', requests fail with HTTP 500 if Redis is unreachable (fail-closed)
RATE_LIMIT_FAIL_OPEN=true

# Duration in seconds to block a device after it exceeds the rate limit (default: 180 = 3 minutes)
RATE_LIMIT_BLOCK_DURATION_SECONDS=180

# Whether to set the 'Secure' attribute on the HttpOnly 'device_id' cookie.
# Leave 'false' for local HTTP development; set to 'true' in HTTPS production environments
RATE_LIMIT_COOKIE_SECURE=false

# ==============================================================================
# 7. DATABASE SEEDING CONFIGURATION
# ==============================================================================

# Must be set to 'development' to permit running the Prisma seed script
SEED_ENV=development

# Password assigned to default seeded accounts (must be at least 12 characters)
SEED_DEFAULT_PASSWORD=
